# Sao file này thành .env.local rồi điền.
# Chat của Z.MKT dùng Claude. Không có khoá thì chat vẫn chạy nhưng trả lời rằng chưa nối AI.
ANTHROPIC_API_KEY=
# Mô hình cho chat (mặc định claude-opus-5-5).
# ZMKT_MODEL=claude-opus-5-5

# CHỈ ĐỂ TEST TRÊN MÁY CÁ NHÂN: dùng gói Claude (Pro/Max) qua Claude Code đang đăng nhập trên máy này,
# thay cho API key. Không dùng khi đưa cho người khác dùng.
# ZMKT_AI=claude-code
# ZMKT_CLI_MODEL=sonnet

# Không đặt thì dùng Postgres nhúng (PGlite) ở .data/pg. Đặt để chạy trên Supabase/Postgres thật.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# simulator (mặc định) hoặc meta (cần META_ACCESS_TOKEN, META_AD_ACCOUNT_ID; phần gọi API chưa viết).
ADS_MODE=simulator
